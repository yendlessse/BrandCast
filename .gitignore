# 비밀 설정
.env
.env.*
!.env.example
설정/프로젝트_설정.env

# Jupyter 임시 파일
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python 생성 파일
__pycache__/
*.py[cod]
.venv/
venv/

# 수집 원본과 변환 중간 데이터
데이터/원본/**
!데이터/원본/**/
!데이터/원본/**/.gitkeep
데이터/중간/**
데이터/임시/**

# 댓글 원문
데이터/**/댓글_원문/**

# 로컬 DB와 임시 산출물
*.db
*.sqlite
*.sqlite3
*.tmp

# 운영체제 및 편집기 파일
.DS_Store
Thumbs.db
.vscode/
.idea/
